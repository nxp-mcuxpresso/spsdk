# This is configuration file that is used for YAML diff widget for showing
# the difference between the user configuration and the default configuration.
template_yaml: workspace/dc_config.yaml
user_cfg: inputs/dc_config.yaml
custom_command: "%! nxpdebugmbox dat dc get-template -f mimx9596 -o workspace/dc_config.yaml --force"

comments:
  cc_socu: "Changed to value 0x00FFFFF0 to open all debug domains. For more info about this value check the documentation"
  uuid: "The template file uses zeroized UUID. To create a debug credential file for a specific part run the 'tool get-uuid' command and replace the zeros with the returned UUID value"
  public_key_0: "Set the Debug Credential Key (DCK) public key used in this example"
  signer_0: "Set the Root of Trust (SRK) private key used to sign the debug credential file"

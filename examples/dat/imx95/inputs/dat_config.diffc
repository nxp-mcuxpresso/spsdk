# This is configuration file that is used for YAML diff widget for showing
# the difference between the user configuration and the default configuration.
template_yaml: workspace/dat_config.yaml
user_cfg: inputs/dat_config.yaml
custom_command: "%! nxpdebugmbox dat get-template -f mimx9596 -o workspace/dat_config.yaml --force"

comments:
  srk_set: "We keep default value on OEM"
  signer: "Set the Debug Credential Key (DCK) private key used in this example"
  srk_table: "Set the Root of Trust (SRK) table matching the one fused into the device"
  certificate: "Path to the debug credential file that we created in the previous step"

//
// J-Link Commander script to program the MISR-authenticated Master Boot Image
// and the matching CMPA_PSWD (seed) binary onto the MCXC353 target.
//
// MCXC353 does not support ISP mode, so provisioning must be done over the
// debug interface (SWD) using J-Link Commander's LoadFile command instead of
// blhost/pfr write over an ISP connection.
//
// Run with (from the mcxc353_misr_image example directory):
//   JLink.exe -NoGui 1 -ExitOnError 1 -CommandFile inputs/program_misr.jlink
device MCXC353
si SWD          // Select interface
speed 4000      // Select speed
connect
r               // Reset
h               // Halt

// Erase the whole CMPA sector (0x01002000-0x01003FFF, 8 KB) before reprogramming.
// CMPA_CFG (0x01002000), CMPA_PSWD (0x01002800) and CMPA_LC (0x01003000) all
// live in this sector. Flash programming can only clear bits (1 -> 0), so without
// this erase a changed MISR seed would end up as AND(old_seed, new_seed) instead
// of the new value, and the ROM would reject the image at boot.
Erase 0x01002000, 0x01003FFF

// Write the CMPA_PSWD binary (contains IMG_MISR_SEED) to the CMPA password page
LoadFile workspace/cmpa_pswd.bin 0x01002800

// Write the MISR-authenticated Master Boot Image to the start of the application flash
LoadFile workspace/mbi_misr.bin 0x0

r               // Reset
g               // Go - start the application
exit

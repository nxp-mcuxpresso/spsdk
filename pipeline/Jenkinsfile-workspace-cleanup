// Weekly housekeeping job: scans the Jenkins workspace root on every online
// agent (each node individually, not one node per label) and removes job workspaces that have had no file modified for more than
// MAX_AGE_DAYS days. This catches "forgotten" workspaces left behind by
// deleted/renamed jobs, failed cleanups, crashed agents, etc. - things that
// per-job `cleanWs()` calls cannot catch because they only clean up after
// their own job.
//
// It also clears the shared `uv` and `pip` package caches on each agent. Those
// caches are global (not tied to a single job's workspace) and are repopulated
// automatically on next use, so they are safe to wipe entirely every week.
//
// Safety:
//  - A workspace is only deleted if NONE of its files were modified within
//    MAX_AGE_DAYS. Any actively running build keeps writing to its own
//    workspace, so it is never a deletion candidate.
//  - This job's own workspace is always excluded.
//  - DRY_RUN defaults to false: the weekly cron run performs real
//    deletion. Set DRY_RUN to true via "Build with Parameters" to preview
//    what would be deleted without actually deleting anything.

@Library('shared-lib') _

pipeline {
    agent none

    options {
        timeout(time: 4, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout()   // this job does not need the SPSDK repo checked out
    }

    parameters {
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'If true, only list workspaces that would be deleted, without deleting them.'
        )
        string(
            name: 'MAX_AGE_DAYS',
            defaultValue: '7',
            description: 'Delete workspace directories with no file modified in the last N days.'
        )
    }

    triggers {
        cron('H 4 * * 6')   // once a week, Saturday ~04:00 (H = Jenkins hash offset)
    }

    stages {
        stage('Cleanup stale workspaces') {
            steps {
                script {
                    def labels = ['linux-spsdk', 'mac', 'windows-spsdk', 'spsdk-doc']
                    def nodeNames = labels.collectMany { nodesByLabel(label: it) }.unique()
                    echo "Cleaning nodes: ${nodeNames}"
                    def branches = [:]
                    nodeNames.each { nodeName ->
                        branches[nodeName] = {
                            // A busy or hung node must not block the cleanup of the others.
                            timeout(time: 1, unit: 'HOURS') {
                                node(nodeName) {
                                    cleanupNode(nodeName)
                                }
                            }
                        }
                    }
                    parallel branches
                }
            }
        }
    }

    post {
        failure {
            emailext(body: '${DEFAULT_CONTENT}', mimeType: 'text/html',
                replyTo: '$DEFAULT_REPLYTO', subject: '${DEFAULT_SUBJECT}',
                to: emailextrecipients([[$class: 'DevelopersRecipientProvider'],
                                        [$class: 'RequesterRecipientProvider']]))
        }
    }
}

def cleanupNode(String nodeName) {
    def maxAgeDays = params.MAX_AGE_DAYS as int

    if (isUnix()) {
        def wsRoot = sh(script: 'dirname "$WORKSPACE"', returnStdout: true).trim()
        echo "[${nodeName}] Workspace root: ${wsRoot}"
        sh """
            set -eu
            WS_ROOT='${wsRoot}'
            SELF_WS='${env.WORKSPACE}'
            MAX_AGE_DAYS=${maxAgeDays}
            DRY_RUN='${params.DRY_RUN}'

            echo "Scanning \$WS_ROOT (max age: \$MAX_AGE_DAYS days, dry_run=\$DRY_RUN)"
            for dir in "\$WS_ROOT"/*/ ; do
                dir="\${dir%/}"
                [ -d "\$dir" ] || continue
                [ "\$dir" = "\$SELF_WS" ] && continue

                # Any file modified within MAX_AGE_DAYS days? -> keep.
                recent=\$(find "\$dir" -type f -mtime -"\$MAX_AGE_DAYS" -print -quit 2>/dev/null || true)
                if [ -z "\$recent" ]; then
                    size=\$(du -sh "\$dir" 2>/dev/null | cut -f1)
                    if [ "\$DRY_RUN" = "true" ]; then
                        echo "[DRY RUN] would delete: \$dir (size: \$size)"
                    else
                        echo "Deleting: \$dir (size: \$size)"
                        rm -rf "\$dir"
                    fi
                fi
            done

            echo "Cleaning uv cache"
            if command -v uv >/dev/null 2>&1; then
                uvCacheDir=\$(uv cache dir 2>/dev/null || true)
                if [ "\$DRY_RUN" = "true" ]; then
                    size=\$(du -sh "\$uvCacheDir" 2>/dev/null | cut -f1)
                    echo "[DRY RUN] would run: uv cache clean (cache dir: \$uvCacheDir, size: \${size:-unknown})"
                else
                    echo "Running: uv cache clean (cache dir: \$uvCacheDir)"
                    # Do not let a cache-cleanup failure (e.g. permission
                    # issues on the cache root dir left by a previous
                    # owner/process) abort the whole job - just warn.
                    if ! uv cache clean; then
                        echo "WARNING: uv cache clean failed (cache dir: \$uvCacheDir), continuing"
                    fi
                fi
            else
                echo "uv not found on PATH, skipping uv cache cleanup"
            fi

            PIP_CACHE_DIR="\$HOME/.cache/pip"
            [ "\$(uname)" = "Darwin" ] && PIP_CACHE_DIR="\$HOME/Library/Caches/pip"
            if [ -d "\$PIP_CACHE_DIR" ]; then
                size=\$(du -sh "\$PIP_CACHE_DIR" 2>/dev/null | cut -f1)
                if [ "\$DRY_RUN" = "true" ]; then
                    echo "[DRY RUN] would delete pip cache: \$PIP_CACHE_DIR (size: \$size)"
                else
                    echo "Deleting pip cache: \$PIP_CACHE_DIR (size: \$size)"
                    rm -rf "\$PIP_CACHE_DIR" || echo "WARNING: pip cache cleanup failed, continuing"
                fi
            fi
        """
    } else {
        def wsRoot = powershell(
            script: '(Get-Item -LiteralPath $env:WORKSPACE).Parent.FullName',
            returnStdout: true
        ).trim()
        // Resolve the self-workspace path the same way (.FullName) as the
        // directories discovered below, so the string comparison used for
        // self-exclusion is not defeated by a '/' vs '\' mismatch between
        // env.WORKSPACE (as reported by Jenkins) and .NET's FullName.
        def selfWs = powershell(
            script: '(Get-Item -LiteralPath $env:WORKSPACE).FullName',
            returnStdout: true
        ).trim()
        echo "[${nodeName}] Workspace root: ${wsRoot}"
        powershell """
            \$ErrorActionPreference = 'Stop'
            \$wsRoot    = '${wsRoot}'
            \$selfWs    = '${selfWs}'
            \$maxAge    = ${maxAgeDays}
            \$dryRun    = \$${params.DRY_RUN}
            \$cutoff    = (Get-Date).AddDays(-\$maxAge)

            Write-Host "Scanning \$wsRoot (cutoff: \$cutoff, dry_run=\$dryRun)"
            Get-ChildItem -LiteralPath \$wsRoot -Directory -ErrorAction SilentlyContinue | ForEach-Object {
                \$dir = \$_.FullName
                if (\$dir -eq \$selfWs) { return }

                \$recent = Get-ChildItem -LiteralPath \$dir -Recurse -File -ErrorAction SilentlyContinue |
                    Where-Object { \$_.LastWriteTime -gt \$cutoff } |
                    Select-Object -First 1

                if (-not \$recent) {
                    \$sizeMB = [math]::Round(
                        ((Get-ChildItem -LiteralPath \$dir -Recurse -File -ErrorAction SilentlyContinue |
                            Measure-Object -Property Length -Sum).Sum / 1MB), 1)
                    if (\$dryRun) {
                        Write-Host "[DRY RUN] would delete: \$dir (size: \$sizeMB MB)"
                    } else {
                        Write-Host "Deleting: \$dir (size: \$sizeMB MB)"
                        Remove-Item -LiteralPath \$dir -Recurse -Force -ErrorAction SilentlyContinue
                    }
                }
            }

            Write-Host "Cleaning uv cache"
            \$uvCmd = Get-Command uv -ErrorAction SilentlyContinue
            if (\$uvCmd) {
                \$uvCacheDir = (uv cache dir 2>\$null)
                if (\$dryRun) {
                    \$sizeMB = 'unknown'
                    if (\$uvCacheDir -and (Test-Path -LiteralPath \$uvCacheDir)) {
                        \$sizeMB = [math]::Round(
                            ((Get-ChildItem -LiteralPath \$uvCacheDir -Recurse -File -ErrorAction SilentlyContinue |
                                Measure-Object -Property Length -Sum).Sum / 1MB), 1)
                    }
                    Write-Host "[DRY RUN] would run: uv cache clean (cache dir: \$uvCacheDir, size: \$sizeMB MB)"
                } else {
                    Write-Host "Running: uv cache clean (cache dir: \$uvCacheDir)"
                    # Do not let a cache-cleanup failure (e.g. permission
                    # issues on the cache root dir left by a previous
                    # owner/process) abort the whole job - just warn.
                    # Native executables don't throw on non-zero exit in
                    # older PowerShell, so check \$LASTEXITCODE explicitly;
                    # wrap in try/catch too in case
                    # \$PSNativeCommandUseErrorActionPreference (PS 7.3+)
                    # turns it into a terminating error.
                    try {
                        uv cache clean
                        if (\$LASTEXITCODE -ne 0) {
                            Write-Host "WARNING: uv cache clean failed (exit code \$LASTEXITCODE, cache dir: \$uvCacheDir), continuing"
                        }
                    } catch {
                        Write-Host "WARNING: uv cache clean failed (cache dir: \$uvCacheDir): \$_"
                    }
                }
            } else {
                Write-Host "uv not found on PATH, skipping uv cache cleanup"
            }

            \$pipCacheDir = Join-Path \$env:LOCALAPPDATA 'pip\\Cache'
            if (Test-Path -LiteralPath \$pipCacheDir) {
                if (\$dryRun) {
                    Write-Host "[DRY RUN] would delete pip cache: \$pipCacheDir"
                } else {
                    Write-Host "Deleting pip cache: \$pipCacheDir"
                    Remove-Item -LiteralPath \$pipCacheDir -Recurse -Force -ErrorAction SilentlyContinue
                }
            }
        """
    }
}

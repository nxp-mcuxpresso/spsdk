@Library('shared-lib') _

// Abort older builds
def buildNumber = BUILD_NUMBER as int
if (buildNumber > 1) milestone(buildNumber - 1)
milestone(buildNumber)

pipeline {
    agent { label 'linux-spsdk' }
    options {
        timeout(time: 1, unit: 'HOURS', activity: true)   // timeout on whole pipeline job
        buildDiscarder(logRotator(daysToKeepStr: '30'))   // discard builds older than one month
    }

    environment {
        PYTEST_ADDOPTS = "--no-cov"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                        $class: 'GitSCM',
                        branches: scm.branches,
                        doGenerateSubmoduleConfigurations: scm.doGenerateSubmoduleConfigurations,
                        extensions: scm.extensions + [[$class: 'CloneOption', noTags: false, reference: '', shallow: false],
                                                      [$class: 'CleanBeforeCheckout', deleteUntrackedNestedRepositories: true]],
                        submoduleCfg: [],
                        userRemoteConfigs: scm.userRemoteConfigs
                    ])
            }
        }
        stage('Codecheck') {
            steps {
                withVenv(
                    'tox --recreate -e py310,py314 -x "testenv.extras=" -- -dc gitcov'
                )
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports_py310/**/*.txt, reports_py314/**/*.txt', fingerprint: true
        }
        failure {
            emailext(body: '${DEFAULT_CONTENT}', mimeType: 'text/html',
                replyTo: '$DEFAULT_REPLYTO', subject: '${DEFAULT_SUBJECT}',
                to: emailextrecipients([[$class: 'DevelopersRecipientProvider'],
                                        [$class: 'RequesterRecipientProvider']]))
        }
        cleanup {
            // Per-PR workspaces (venvs, build outputs) are 1-2 GB each and fill agent disks.
            cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        }
    }
}
